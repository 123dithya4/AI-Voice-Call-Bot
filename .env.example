# Vapi private API key
VAPI_API_KEY=replace_with_vapi_private_key
VAPI_PHONE_NUMBER_ID=replace_with_outbound_enabled_phone_number_id
VAPI_ASSISTANT_ID=replace_with_assistant_id
# Must match the assistant's model configuration when overriding its prompt
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL_NAME=gpt-3.5-turbo

# ElevenLabs (used by api.py)
ELEVENLABS_API_KEY=replace_with_elevenlabs_api_key
ELEVENLABS_VOICE_ID=replace_with_elevenlabs_voice_id

# Optional secure administrator provisioning
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Optional database URL (defaults to local SQLite)
# DATABASE_URL=sqlite:///./vapi_calls.db
